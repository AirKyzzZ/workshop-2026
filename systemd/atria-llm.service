[Unit]
Description=ATRIA modele de langage local, lecture seule
After=multi-user.target

[Service]
Type=simple
User=atria
ExecStart=/home/atria/llama.cpp/build/bin/llama-server \
  --model /home/atria/atria/models/llm/qwen2.5-1.5b-instruct-q4_k_m.gguf \
  --host 127.0.0.1 --port 8080 \
  --ctx-size 2048 --threads 3 --no-webui
Restart=always
RestartSec=5
Nice=10
CPUQuota=300%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
