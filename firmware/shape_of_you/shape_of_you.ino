void setup()
{
  Serial.begin(115200);
  while (!Serial) {}
  pinMode(BUZZER_PIN, OUTPUT);
  Serial.println(F("Shape of You - lecture"));
  playSong();
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
  Serial.println(F("FIN"));
}

void playSong()
{
  const int size = sizeof(durations) / sizeof(int);

  for (int note = 0; note < size; note++) {
    int duration = (1000L * 10) / ((long)durations[note] * SPEED_X10);
    tone(BUZZER_PIN, melody[note], duration);
    delay(duration * 13 / 10);
    noTone(BUZZER_PIN);
  }
}

void loop() {}
